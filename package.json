{
  "name": "copanquest",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && node scripts/clean-appledouble.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "heightmap": "node scripts/dem-to-heightmap.mjs && node scripts/dem-to-heightmap.mjs --size 30000 --spacing 150 --name copan-region",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "tsc && cf deploy"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "ecctrl": "^2.0.2",
    "leva": "^0.10.1",
    "nipplejs": "^1.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cf": "^1.0.0-beta.28",
    "geotiff": "^3.0.5",
    "typescript": "5.9",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261109.1": true,
    "workerd@1.20261104.1": true
  }
}
